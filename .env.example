# Server Configuration
PORT=3000
NODE_ENV=development

# Public API Configuration
NUXT_PUBLIC_API_BASE=/api

# OpenAI server-only credentials. Never use a NUXT_PUBLIC_ prefix for these.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_VISION_MODEL=
NUXT_OPENAI_SOLVE_MODEL=
NUXT_AI_DAILY_OCR_LIMIT=20
NUXT_AI_DAILY_SOLVE_LIMIT=15

# Supabase: publishable values are safe for the browser; secret key is server-only.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SECRET_KEY=
