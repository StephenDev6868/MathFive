# Public Nuxt runtime configuration (safe publishable values only)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_example

# Server ONLY. Never expose through NUXT_PUBLIC_*.
NUXT_SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET
NUXT_OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_KEY

# Check that chosen models support images / Structured Outputs and verify live pricing.
NUXT_OPENAI_VISION_MODEL=REPLACE_WITH_VISION_CAPABLE_MODEL
NUXT_OPENAI_SOLVE_MODEL=REPLACE_WITH_STRUCTURED_OUTPUT_MODEL
NUXT_AI_DAILY_OCR_LIMIT=20
NUXT_AI_DAILY_SOLVE_LIMIT=15
